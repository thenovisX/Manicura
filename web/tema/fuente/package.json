{
  "name": "tema-laca",
  "private": true,
  "description": "Fuente del JavaScript del tema Laca. Se compila a ../assets/tema.js.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --legal-comments=eof --outfile=../assets/tema.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2019 --sourcemap=inline --outfile=../assets/tema.js --watch"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "ogl": "^1.0.11",
    "split-type": "^0.3.4"
  }
}
